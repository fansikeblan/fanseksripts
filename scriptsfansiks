local scripts = {
    "https://raw.githubusercontent.com/fansikeblan/fanseksripts/refs/heads/fansikebl/scripttds?token=GHSAT0AAAAAAD2D7TZQ7WNRW4YBGN22WJSS2OZJJXA",
    "https://raw.githubusercontent.com/1Qlua-RBXscript/1qlua/refs/heads/main/Roblox",
}

for i, url in ipairs(scripts) do
    coroutine.wrap(function()
        local success, err = pcall(function()
            local scriptContent = game:HttpGet(url)
            loadstring(scriptContent)()
        end)

        if not success then
        else
        end
    end)()
end
