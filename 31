local index = 1
local busy = false
local autoRunning = false
local autoThread = nil
local DRAG_THRESHOLD_PX = 10
local function getRoot()
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart")
end
local function teleportToNext()
	local root = getRoot()
	if not root then
		return
	end
	local pos = TELEPORT_POINTS[index]
	if not pos then
		return
	end
	root.CFrame = CFrame.new(pos)
	index += 1
	if index > #TELEPORT_POINTS then
		index = 1
	end
end
-- Ручной режим: удержание E
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or busy or autoRunning then
		return
	end
	if input.KeyCode ~= Enum.KeyCode.E then
		return
	end
	busy = true
	task.spawn(function()
		local t0 = os.clock()
		while UserInputService:IsKeyDown(Enum.KeyCode.E) do
			if os.clock() - t0 >= HOLD_SECONDS then
				teleportToNext()
				break
			end
			task.wait(0.05)
		end
		busy = false
	end)
end)
