local function getHumanoidRootPart()
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(position)
	local hrp = getHumanoidRootPart()
	if hrp then
		hrp.CFrame = CFrame.new(position)
	end
end

local function isEHeld()
	return UserInputService:IsKeyDown(Enum.KeyCode.E)
end

-- Ожидание персонажа перед стартом
if not player.Character then
	player.CharacterAdded:Wait()
end
task.wait(0.5)

-- Старт после того, как зажали E (иначе цикл сразу завершится)
repeat
	task.wait()
until isEHeld()

while isEHeld() do
	for _, pos in ipairs(POINTS) do
		if not isEHeld() then
			break
		end
		teleportTo(pos)
		task.wait(1)
		if not isEHeld() then
			break
		end
		task.wait(1) -- удержание E для взаимодействия в игре (клавиша уже зажата)
	end
end
