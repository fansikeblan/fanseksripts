local function setAutoRunning(on)
	autoRunning = on
	if on then
		button.Text = "Стоп"
		button.BackgroundColor3 = Color3.fromRGB(80, 35, 35)
	else
		button.Text = "Телепорт (авто)"
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	end
end
local function runAutoLoop()
	while autoRunning do
		local root = getRoot()
		if not root then
			task.wait(0.2)
			continue
		end
		local pos = TELEPORT_POINTS[index]
		if not pos then
			break
		end
		root.CFrame = CFrame.new(pos)
		index += 1
		if index > #TELEPORT_POINTS then
			index = 1
		end
		task.wait(AUTO_HOLD_SECONDS)
	end
	setAutoRunning(false)
end
local dragging = false
local dragStartMouse = Vector2.zero
local dragStartPosOffset = Vector2.zero
local pointerDownOnButton = false
RunService.RenderStepped:Connect(function()
	if not dragging then
		return
	end
	if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		dragging = false
		return
	end
	local cur = UserInputService:GetMouseLocation()
	local delta = cur - dragStartMouse
	button.Position = UDim2.fromOffset(dragStartPosOffset.X + delta.X, dragStartPosOffset.Y + delta.Y)
end)
button.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	pointerDownOnButton = true
	dragging = true
	dragStartMouse = UserInputService:GetMouseLocation()
	dragStartPosOffset = Vector2.new(button.AbsolutePosition.X, button.AbsolutePosition.Y)
end)
UserInputService.InputEnded:Connect(function(input, _processed)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	if not pointerDownOnButton then
		return
	end
	pointerDownOnButton = false
	local endMouse = UserInputService:GetMouseLocation()
	local moved = (endMouse - dragStartMouse).Magnitude
	dragging = false
	if moved >= DRAG_THRESHOLD_PX then
		return
	end
	-- короткий клик — переключить авто
	if autoRunning then
		autoRunning = false
		if autoThread then
			task.cancel(autoThread)
			autoThread = nil
		end
		setAutoRunning(false)
	else
		setAutoRunning(true)
		autoThread = task.spawn(runAutoLoop)
	end
end)
